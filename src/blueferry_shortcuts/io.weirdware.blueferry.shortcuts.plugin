[BlueFerry Plugin]
Id=io.weirdware.blueferry.shortcuts
Name=iOS Shortcuts bridge
Version=0.2.1
ApiVersion=1.3
MinBlueFerry=0.8.1
Capabilities=card;notify;
Homepage=https://github.com/joshii-h/blueferry-plugin-shortcuts
Source=https://github.com/joshii-h/blueferry-plugin-shortcuts
Exec=blueferry-shortcuts serve
Cli=blueferry-shortcuts
Alias=shortcuts
ConfigTest=true

[ConfigGroup options]
Help=How the iPhone reaches this computer.

[Config bind_address]
Label=Listen on
Type=string
Group=options
Placeholder=192.168.1.20
Example=enp5s0 or 192.168.1.20
Help=An IP address or interface name. Empty: the interface of the default route. The iPhone must be on the same network.

[Config allow_all_interfaces]
Label=Allow all interfaces
Type=bool
Default=false
Advanced=true
Help=Needed to listen on 0.0.0.0 or ::. Keep it off unless you know every network this PC joins.

[Config port]
Label=Port
Type=int
Default=47801
Min=1024
Max=65535
Group=options
ErrorText=Use a port from 1024 to 65535.

[Config token]
Label=Access token
Type=secret
Advanced=true
Help=Created automatically. Enter it in the shortcut as the header "Authorization: Bearer <token>".
HelpUrl=https://github.com/joshii-h/blueferry-plugin-shortcuts#the-request-action

[Config allow_clipboard_read]
Label=Let shortcuts read the PC clipboard
Type=bool
Default=false
Group=options
Help=Enables GET /clipboard. Off unless you know who has the token: anyone with it could read what you copy.

[Config accept_images]
Label=Accept images for the clipboard
Type=bool
Default=false
Group=options
Help=PNG, JPEG, GIF or WebP up to 10 MB on POST /clipboard.
