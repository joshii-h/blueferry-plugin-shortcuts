[BlueFerry Plugin]
Id=io.weirdware.blueferry.shortcuts
Name=iOS Shortcuts bridge
Version=0.3.0
ApiVersion=1.3
MinBlueFerry=0.8.1
Capabilities=card;notify;
Homepage=https://github.com/joshii-h/blueferry-plugin-shortcuts
Source=https://github.com/joshii-h/blueferry-plugin-shortcuts
Exec=blueferry-shortcuts serve
Cli=blueferry-shortcuts
Alias=shortcuts
ConfigTest=true

[ConfigGroup options]
Help=How the iPhone reaches this computer.

[Config bind_address]
Label=Listen on
Type=string
Group=options
Placeholder=192.168.1.20
Example=enp5s0 or 192.168.1.20
Help=An IP address or interface name. Empty: the interface of the default route. The iPhone must be on the same network.

[Config allow_all_interfaces]
Label=Allow all interfaces
Type=bool
Default=false
Advanced=true
Help=Needed to listen on 0.0.0.0 or ::. Keep it off unless you know every network this PC joins.

[Config port]
Label=Port
Type=int
Default=47801
Min=1024
Max=65535
Group=options
ErrorText=Use a port from 1024 to 65535.

[Config token]
Label=Access token
Type=secret
Advanced=true
Help=Created automatically. "Set up iPhone" on the card shows it on the iPhone with a Copy button.
HelpUrl=https://github.com/joshii-h/blueferry-plugin-shortcuts#the-request-action

[Config allow_clipboard_read]
Label=Let shortcuts read the PC clipboard
Type=bool
Default=false
Group=options
Help=Enables GET /clipboard. Off unless you know who has the token: anyone with it could read what you copy.

[Config accept_images]
Label=Accept images for the clipboard
Type=bool
Default=false
Group=options
Help=PNG, JPEG, GIF or WebP up to 10 MB on POST /clipboard.

[Config shortcut_url]
Label=Shortcut link
Type=url
Group=options
Placeholder=https://www.icloud.com/shortcuts/…
Pattern=^(https://(www\.)?icloud\.com/shortcuts/[0-9A-Za-z]{16,64}/?)?$
ErrorText=Paste the iCloud link of the shared BlueFerry shortcut.
Help=The iCloud link of the shared "BlueFerry" shortcut. The setup page offers it as "Add shortcut". Empty: the built-in link, if any.
HelpUrl=https://github.com/joshii-h/blueferry-plugin-shortcuts#the-blueferry-shortcut

[Config allow_http]
Label=Allow unencrypted in the home network (HTTP)
Type=bool
Default=false
Advanced=true
Help=Lets shortcuts work without the certificate. Anyone in the same Wi-Fi can read what is sent. Only in networks you approve (NetworkManager profile); never in open Wi-Fi. Reading the PC clipboard always needs HTTPS.
HelpUrl=https://github.com/joshii-h/blueferry-plugin-shortcuts#unencrypted-in-the-home-network

[Config http_port]
Label=HTTP port
Type=int
Default=47800
Min=1024
Max=65535
Advanced=true
ShowIf=allow_http=true
ErrorText=Use a port from 1024 to 65535.

[Config http_networks]
Label=Approved networks
Type=string
Advanced=true
ShowIf=allow_http=true
Help=The networks approved for HTTP, set when you turn it on or tap "Approve this network" on the card. Delete a name to remove it.
